---
import { MagneticButton } from '@/components/MagneticButton'
import { Marquee } from '@/components/Marquee'
import { SITE } from '@/lib/seo'

const AUDIT_HREF = `${SITE.whatsapp}?text=${encodeURIComponent(
  'Hola Sofía! Quiero pedir la auditoría gratis de mi cuenta.',
)}`

// Static Astro shell: the hero copy (incl. the LCP value-prop) is plain SSR
// HTML so it paints at FCP and is never re-rendered by island hydration.
// Only the genuinely interactive bits hydrate as small islands.
---

<section
  id="inicio"
  class="bg-paper text-ink relative z-[2] flex min-h-[100dvh] flex-col overflow-clip px-6 pt-24 pb-6 sm:px-10"
>
  <div class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-1 flex-col">
    {/* founder line — static, above the fold */}
    <p class="text-ink/70 text-[11px] font-bold tracking-[0.28em] uppercase">
      Sofía Herrero · Marketing digital
    </p>

    {/* poster cover: the logo lockup fills (almost) the whole width; the
        brand line sits under the wordmark, where the logo's tagline goes.
        On desktop the width is also capped by the viewport height
        (20rem ≈ menu + founder line + buttons + tape; 1.706 = logo ratio)
        so the whole logo fits on screen without scrolling. */}
    <div class="flex flex-1 flex-col items-center justify-center py-8">
      <div class="relative -mx-4 w-[calc(100%+2rem)] max-w-[84rem] [container-type:inline-size] sm:mx-0 sm:w-[min(96vw,84rem,max(30rem,calc((100dvh_-_20rem)_*_1.706)))]">
        <h1 class="m-0">
          <img
            src="/logo-jalapeno-v3.webp"
            srcset="/logo-jalapeno-v3-1400.webp 1400w, /logo-jalapeno-v3.webp 2749w"
            sizes="(min-width: 640px) min(96vw, 84rem, max(30rem, calc((100dvh - 20rem) * 1.706))), calc(100vw + 2rem)"
            alt="Jalapeño"
            width="2749"
            height="1611"
            fetchpriority="high"
            decoding="async"
            class="block h-auto w-full mix-blend-multiply"
          />
        </h1>
        <p class="text-ink absolute top-[59.5%] left-[57%] m-0 text-[max(12px,3cqw)] leading-none font-medium whitespace-nowrap">
          si no <span class="text-chili">arde</span>, no impacta.
        </p>
      </div>
    </div>

    {/* CTAs only — the cover carries no copy */}
    <div class="flex justify-center">
      {/* phones: three compact pills in one row; desktop: full buttons */}
      <div class="grid w-full max-w-md grid-cols-3 gap-1.5 sm:flex sm:w-auto sm:max-w-none sm:flex-wrap sm:items-center sm:justify-center sm:gap-3">
        <MagneticButton
          client:visible
          href="#contacto"
          className="min-h-[40px] w-full justify-center gap-0 px-2 py-2 text-[10.5px] tracking-normal whitespace-nowrap sm:w-auto sm:gap-3 sm:px-6 sm:py-3 sm:text-sm sm:tracking-wide"
          iconClassName="hidden sm:flex"
        >
          Hablemos
        </MagneticButton>
        <MagneticButton
          client:visible
          href="#proyectos"
          variant="ghost"
          className="text-ink ring-ink/30 hover:bg-ink hover:text-paper min-h-[40px] w-full justify-center gap-0 px-2 py-2 text-[10.5px] tracking-normal whitespace-nowrap sm:w-auto sm:gap-3 sm:px-6 sm:py-3 sm:text-sm sm:tracking-wide"
          iconClassName="hidden sm:flex"
        >
          <span class="sm:hidden">Proyectos</span>
          <span class="hidden sm:inline">Ver proyectos</span>
        </MagneticButton>
        <MagneticButton
          client:visible
          href={AUDIT_HREF}
          variant="ghost"
          className="text-ink ring-ink/30 hover:bg-ink hover:text-paper min-h-[40px] w-full justify-center gap-0 px-2 py-2 text-[10.5px] tracking-normal whitespace-nowrap sm:w-auto sm:gap-3 sm:px-6 sm:py-3 sm:text-sm sm:tracking-wide"
          iconClassName="hidden sm:flex"
        >
          <span class="sm:hidden">Auditoría gratis</span>
          <span class="hidden sm:inline">Pedí tu auditoría gratis</span>
        </MagneticButton>
      </div>
    </div>
  </div>

  {/* tape tagline marquee */}
  {/* full-bleed: negative margins cancel the section padding (and a bit
      more so the tilted strip still reaches both edges) */}
  <div class="relative -mx-10 mt-7 sm:-mx-16">
    <div class="bg-ink/55 -rotate-1 py-2.5 backdrop-blur-sm">
      <Marquee
        client:visible
        text="jalapeño · marketing digital · crecimiento de marcas"
        className="font-display text-paper text-sm tracking-wide uppercase sm:text-base"
      />
    </div>
  </div>
</section>
