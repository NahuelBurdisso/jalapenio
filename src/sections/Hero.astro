---
import { KineticClaim } from '@/components/KineticClaim'
import { MagneticButton } from '@/components/MagneticButton'
import { Marquee } from '@/components/Marquee'
import { SITE } from '@/lib/seo'

const AUDIT_HREF = `${SITE.whatsapp}?text=${encodeURIComponent(
  'Hola Sofía! Quiero pedir la auditoría gratis de mi cuenta.',
)}`

// Static Astro shell: the hero copy (incl. the LCP value-prop) is plain SSR
// HTML so it paints at FCP and is never re-rendered by island hydration.
// Only the genuinely interactive bits hydrate as small islands.
---

<section
  id="inicio"
  class="bg-paper text-ink relative z-[2] flex min-h-[100dvh] flex-col overflow-clip px-6 pt-24 pb-6 sm:px-10"
>
  <div class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-1 flex-col">
    {/* founder line — static, above the fold */}
    <p class="text-ink/70 text-[11px] font-bold tracking-[0.28em] uppercase">
      Sofía Herrero · Marketing digital
    </p>

    {/* the claim is the hero — static HTML, reveals via CSS (zero JS) */}
    <div class="flex flex-1 flex-col justify-center gap-6 py-8 sm:gap-8">
      <h1 class="m-0">
        <img
          src="/logo-jalapeno-claro.webp"
          alt="Jalapeño — tu marca, pero picante."
          width="1046"
          height="613"
          fetchpriority="high"
          decoding="async"
          class="h-auto w-[min(88vw,40rem)] mix-blend-multiply lg:w-[46rem]"
        />
      </h1>
      <KineticClaim />
    </div>

    {/* value prop + CTAs */}
    <div class="grid items-end gap-7 lg:grid-cols-[1fr_auto]">
      <p class="text-ink/75 max-w-md text-base sm:text-lg">
        Estrategia y gestión de campañas en Meta Ads para negocios y tiendas
        online. Remarketing, anuncios e informes claros de resultados:
        publicidad que arde.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <MagneticButton client:visible href="#contacto">Hablemos</MagneticButton>
        <MagneticButton
          client:visible
          href="#proyectos"
          variant="ghost"
          className="text-ink ring-ink/30 hover:bg-ink hover:text-paper"
        >
          Ver proyectos
        </MagneticButton>
        <MagneticButton
          client:visible
          href={AUDIT_HREF}
          variant="ghost"
          className="text-ink ring-ink/30 hover:bg-ink hover:text-paper"
        >
          Pedí tu auditoría gratis
        </MagneticButton>
      </div>
    </div>
  </div>

  {/* tape tagline marquee */}
  <div class="relative mt-7">
    <div class="bg-ink -rotate-1 py-3">
      <Marquee
        client:visible
        text="jalapeño · marketing digital · crecimiento de marcas"
        className="font-display text-paper/90 text-2xl tracking-wide uppercase sm:text-3xl"
      />
    </div>
  </div>
</section>
